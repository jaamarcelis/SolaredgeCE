  "services": {
    "import_energy_history": {
      "name": "Import energy history",
      "description": "Fetches the lifetime energy of the inverters from SolarEdge for a period and imports it into the statistics of the site's Lifetime energy sensor. Existing statistics are rewritten consistently and later sums are shifted, so there is no jump.",
      "fields": {
        "device_id": {
          "name": "Site",
          "description": "The SolarEdge site device."
        },
        "start": {
          "name": "Start date",
          "description": "First day to import (local time)."
        },
        "end": {
          "name": "End date",
          "description": "Last day to import, inclusive. Default: today. Ends at the last hourly statistic of the recorder."
        },
        "interval": {
          "name": "Interval",
          "description": "5 minutes (also short-term statistics), 1 hour, or 1 day (one row at the end of each day)."
        }
      }
    }
